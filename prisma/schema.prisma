generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  Male
  Female
}

enum ParentType {
  Biological
  Surrogate
  Other
}

enum PartnershipType {
  Lover
  Married
  Ex
}

enum Passion {
  Apathy
  None
  Interested
  Burning
  Natural
  Critical
}

enum LocationType {
  PLAYABLE_MAP
  OUTPOST
  OTHER
}

enum RelicCategory {
  IDEOLOGY
  WEAPON
  PERSONAL
  LEGACY
  STORY
  SYMBOLIC
  OTHER
}

enum StoryStatus {
  DRAFT
  COMPLETE
}

enum StoryDateType {
  SINGLE
  RANGE
  UNKNOWN
}

enum ReferenceMaterialType {
  IMAGE
  TEXT
  FILE
  OTHER
}

model Colonist {
  id        Int     @id @default(autoincrement())
  firstName String
  nickname  String?
  lastName  String
  title     String?
  gender    Gender

  birthYear  Int?
  birthMonth Int?
  birthDay   Int?

  isDead     Boolean @default(false)
  deathYear  Int?
  deathMonth Int?
  deathDay   Int?

  imageURL String?

  images ColonistImage[]

  // Legacy / family line
  legacyId Int?
  legacy   Legacy? @relation("LegacyMembers", fields: [legacyId], references: [id], onDelete: SetNull)

  // If this colonist is the founder of a legacy
  foundedLegacy Legacy? @relation("LegacyFounder")

  // Legacies where this colonist is considered notable
  notableInLegacies LegacyNotableColonist[]

  groups ColonistGroup[]

  children ParentChild[] @relation("Parent")
  parents  ParentChild[] @relation("Child")

  partnerARelationships Partnership[] @relation("PartnerA")
  partnerBRelationships Partnership[] @relation("PartnerB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  colonistSkills ColonistSkill[]
  colonistTraits ColonistTrait[]

  locations Location[]

  ownedRelics     Relic[]          @relation("CurrentRelicOwner")
  relicOwnerships RelicOwnership[]

  storyAssociations StoryColonist[]
}

model ColonistImage {
  id Int @id @default(autoincrement())

  imageURL String
  caption  String?
  order    Int     @default(0)

  colonistId Int
  colonist   Colonist @relation(fields: [colonistId], references: [id], onDelete: Cascade)
}

model Legacy {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  color       String?

  trackForSuccession Boolean @default(true)

  // Colonists belonging to this legacy
  members Colonist[] @relation("LegacyMembers")

  // The colonist who originally founded this legacy
  foundingColonistId Int?      @unique
  foundingColonist   Colonist? @relation("LegacyFounder", fields: [foundingColonistId], references: [id], onDelete: SetNull)

  // Colonists considered historically notable within this legacy
  notableColonists LegacyNotableColonist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations Location[]

  storyAssociations StoryLegacy[]
}

model LegacyNotableColonist {
  legacyId    Int
  colonistId  Int
  description String?

  legacy   Legacy   @relation(fields: [legacyId], references: [id], onDelete: Cascade)
  colonist Colonist @relation(fields: [colonistId], references: [id], onDelete: Cascade)

  @@id([legacyId, colonistId])
}

model ParentChild {
  id       Int        @id @default(autoincrement())
  parentId Int
  childId  Int
  type     ParentType

  parent Colonist @relation("Parent", fields: [parentId], references: [id], onDelete: Cascade)
  child  Colonist @relation("Child", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
}

model Partnership {
  id Int @id @default(autoincrement())

  partnerAId Int
  partnerBId Int
  type       PartnershipType

  partnerA Colonist @relation("PartnerA", fields: [partnerAId], references: [id], onDelete: Cascade)
  partnerB Colonist @relation("PartnerB", fields: [partnerBId], references: [id], onDelete: Cascade)

  @@unique([partnerAId, partnerBId])
}

model Skill {
  id   Int    @id @default(autoincrement())
  name String @unique

  colonistSkills ColonistSkill[]
  expertises     Expertise[]
}

model ColonistSkill {
  id         Int     @id @default(autoincrement())
  colonistId Int
  skillId    Int
  level      Int
  passion    Passion
  isKnown    Boolean @default(true)

  colonist Colonist @relation(fields: [colonistId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  expertises ColonistExpertise[]

  @@unique([colonistId, skillId])
}

model ColonistExpertise {
  id              Int @id @default(autoincrement())
  colonistSkillId Int
  expertiseId     Int
  level           Int

  colonistSkill ColonistSkill @relation(fields: [colonistSkillId], references: [id], onDelete: Cascade)

  expertise Expertise @relation(fields: [expertiseId], references: [id])

  @@unique([colonistSkillId, expertiseId])
}

model Expertise {
  id                 Int                 @id @default(autoincrement())
  skillId            Int
  name               String              @unique
  description        String
  effects            ExpertiseEffect[]
  skill              Skill               @relation(fields: [skillId], references: [id], onDelete: Cascade)
  colonistExpertises ColonistExpertise[]
}

model ExpertiseEffect {
  id          Int     @id @default(autoincrement())
  expertiseId Int
  name        String
  value       Float
  unit        String?

  expertise Expertise @relation(fields: [expertiseId], references: [id], onDelete: Cascade)

  @@unique([expertiseId, name])
}

model Group {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  colonists ColonistGroup[]

  storyAssociations StoryGroup[]
}

model ColonistGroup {
  colonistId Int
  groupId    Int

  colonist Colonist @relation(fields: [colonistId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([colonistId, groupId])
}

model Trait {
  id          Int     @id @default(autoincrement())
  defName     String  @unique
  name        String?
  description String?

  colonistTraits ColonistTrait[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ColonistTrait {
  id         Int @id @default(autoincrement())
  colonistId Int
  traitId    Int

  colonist Colonist @relation(fields: [colonistId], references: [id], onDelete: Cascade)
  trait    Trait    @relation(fields: [traitId], references: [id], onDelete: Cascade)

  @@unique([colonistId, traitId])
}

model Location {
  id          Int          @id @default(autoincrement())
  name        String
  type        LocationType
  description String?

  previousNames LocationPreviousName[]
  images        LocationImage[]
  landmarks     LocationLandmark[]

  colonists Colonist[]
  legacies  Legacy[]
  relics    Relic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storyAssociations StoryLocation[]
}

model LocationPreviousName {
  id    Int    @id @default(autoincrement())
  name  String
  order Int    @default(0)

  locationId Int
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model LocationImage {
  id       Int     @id @default(autoincrement())
  imageURL String
  caption  String?
  order    Int     @default(0)

  locationId Int
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model LocationLandmark {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  locationId Int
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  images LocationLandmarkImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LocationLandmarkImage {
  id Int @id @default(autoincrement())

  imageURL String
  caption  String?
  order    Int     @default(0)

  landmarkId Int
  landmark   LocationLandmark @relation(fields: [landmarkId], references: [id], onDelete: Cascade)
}

model Relic {
  id          Int     @id @default(autoincrement())
  name        String
  type        String?
  description String?

  categories RelicCategory[]

  // Image used for the view and cards while the others are part of the gallery.
  primaryImageURL String?
  origin          String?

  // Some relics are owned by a specific colonist, while others are colony-owned / unowned.
  ownerId Int?
  owner   Colonist? @relation("CurrentRelicOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Where the relic is currently kept / located.
  locationId Int?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  // Previous colonist ownership, when relevant.
  ownershipHistory RelicOwnership[]

  // Relic gallery.
  images RelicImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storyAssociations StoryRelic[]
}

model RelicOwnership {
  id Int @id @default(autoincrement())

  relicId    Int
  colonistId Int

  relic    Relic    @relation(fields: [relicId], references: [id], onDelete: Cascade)
  colonist Colonist @relation(fields: [colonistId], references: [id], onDelete: Cascade)

  order Int @default(0)
}

model RelicImage {
  id Int @id @default(autoincrement())

  imageURL String
  caption  String?
  order    Int     @default(0)

  relicId Int
  relic   Relic @relation(fields: [relicId], references: [id], onDelete: Cascade)
}

model HighlightSnapshot {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Stories
// -----------------------------------------------------------------------------

model Story {
  id      Int         @id @default(autoincrement())
  title   String
  summary String?     @db.Text
  type    String
  status  StoryStatus @default(DRAFT)

  // Canonical Tiptap document JSON. Private comment anchors/marks are retained here
  // for editing, then stripped when generating reader-facing output.
  content Json

  // Private, story-wide drafting notes; never included in the reader-facing story.
  editorialNotes String? @db.Text

  // RimWorld date components are nullable to support partial dates. Month uses the
  // same numeric convention as Colonist.birthMonth / deathMonth (1-4).
  dateType StoryDateType @default(UNKNOWN)

  dateStartDay         Int?
  dateStartMonth       Int?
  dateStartYear        Int?
  dateStartApproximate Boolean @default(false)

  dateEndDay         Int?
  dateEndMonth       Int?
  dateEndYear        Int?
  dateEndApproximate Boolean @default(false)

  tags              StoryTag[]
  collectionLinks   StoryCollectionMembership[]
  editorialComments StoryEditorialComment[]
  referenceLinks    StoryReference[]
  inlineAssets      StoryInlineAsset[]

  relatedColonists StoryColonist[]
  relatedLegacies  StoryLegacy[]
  relatedGroups    StoryGroup[]
  relatedLocations StoryLocation[]
  relatedRelics    StoryRelic[]

  relatedStories StoryRelatedStory[] @relation("StoryRelatedFrom")
  referencedBy   StoryRelatedStory[] @relation("StoryRelatedTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([dateType, dateStartYear])
}

model Tag {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  stories   StoryTag[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model StoryTag {
  storyId Int
  tagId   Int

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([storyId, tagId])
  @@index([tagId])
}

model StoryCollection {
  id        Int                       @id @default(autoincrement())
  name      String                    @unique
  stories   StoryCollectionMembership[]
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
}

model StoryCollectionMembership {
  storyId      Int
  collectionId Int

  story      Story           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  collection StoryCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([storyId, collectionId])
  @@index([collectionId])
}

model StoryEditorialComment {
  // ID is also referenced by the editorialComment mark or editorialCommentAnchor node
  // inside Story.content. Keep the row separate so its text is never published by default.
  id      String @id @default(cuid())
  storyId Int
  text    String @db.Text

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storyId, createdAt])
}

model ReferenceMaterial {
  id    Int                  @id @default(autoincrement())
  title String
  kind  ReferenceMaterialType

  // Optional source name, filename, message source, or other identifier.
  source String? @db.Text

  // Optional excerpt/transcription/details belonging to the reference itself.
  content String? @db.Text

  // IMAGE and FILE references can point to an uploaded object stored in MinIO.
  assetId Int?         @unique
  asset   StoredAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  stories StoryReference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, title])
}

model StoryReference {
  storyId     Int
  referenceId Int

  // Story-specific explanation of why this reusable source matters here.
  contextNote String? @db.Text

  story     Story             @relation(fields: [storyId], references: [id], onDelete: Cascade)
  reference ReferenceMaterial @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@id([storyId, referenceId])
  @@index([referenceId])
}

model StoredAsset {
  id               Int      @id @default(autoincrement())
  objectKey        String   @unique
  originalFileName String
  mimeType         String?
  sizeBytes        Int?

  // Store a MinIO object key, not an environment-specific public URL.
  referenceMaterial ReferenceMaterial?
  inlineStories     StoryInlineAsset[]

  createdAt DateTime @default(now())
}

// Tracks assets used as inline story images. Tiptap content stores the asset ID plus
// presentation attributes (alt text, caption, alignment); this relation supports
// lookups and safe cleanup when images are removed from a story.
model StoryInlineAsset {
  storyId Int
  assetId Int

  story Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  asset StoredAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([storyId, assetId])
  @@index([assetId])
}

// Manual associations and inline-link associations are tracked independently so the
// UI can distinguish Manual, Inline, and Inline + manual, as in the prototype.
model StoryColonist {
  storyId    Int
  colonistId Int
  isManual   Boolean @default(false)
  isInline   Boolean @default(false)

  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  colonist Colonist @relation(fields: [colonistId], references: [id], onDelete: Cascade)

  @@id([storyId, colonistId])
  @@index([colonistId])
}

model StoryLegacy {
  storyId  Int
  legacyId Int
  isManual Boolean @default(false)
  isInline Boolean @default(false)

  story  Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  legacy Legacy @relation(fields: [legacyId], references: [id], onDelete: Cascade)

  @@id([storyId, legacyId])
  @@index([legacyId])
}

model StoryGroup {
  storyId  Int
  groupId  Int
  isManual Boolean @default(false)
  isInline Boolean @default(false)

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([storyId, groupId])
  @@index([groupId])
}

model StoryLocation {
  storyId    Int
  locationId Int
  isManual   Boolean @default(false)
  isInline   Boolean @default(false)

  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([storyId, locationId])
  @@index([locationId])
}

model StoryRelic {
  storyId  Int
  relicId  Int
  isManual Boolean @default(false)
  isInline Boolean @default(false)

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  relic Relic @relation(fields: [relicId], references: [id], onDelete: Cascade)

  @@id([storyId, relicId])
  @@index([relicId])
}

// Directional relationship: story A may reference story B without implying
// that story B must also reference story A.
model StoryRelatedStory {
  storyId        Int
  relatedStoryId Int
  isManual       Boolean @default(false)
  isInline       Boolean @default(false)

  story        Story @relation("StoryRelatedFrom", fields: [storyId], references: [id], onDelete: Cascade)
  relatedStory Story @relation("StoryRelatedTo", fields: [relatedStoryId], references: [id], onDelete: Cascade)

  @@id([storyId, relatedStoryId])
  @@index([relatedStoryId])
}